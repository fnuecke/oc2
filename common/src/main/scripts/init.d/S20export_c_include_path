#!/bin/sh

THIS_SCRIPT_PATH=$(readlink -f "$0")
THIS_SCRIPT_DIR=$(dirname "$THIS_SCRIPT_PATH")

PROFILE_D_PATH="/etc/profile.d"
PROFILE_NAME="c_include_path.sh"
SOURCE_PATH=$(readlink -f "$THIS_SCRIPT_DIR/../include")

start() {
    if [ ! -d "$SOURCE_PATH" ]; then
        return 0
    fi

    {
        printf '# Generated by %s on every boot.\n' "$THIS_SCRIPT_PATH"
        printf '# Any edits here are lost the next time the machine starts.\n'
        echo 'if [ -z "$C_INCLUDE_PATH" ]; then'
        echo '    export C_INCLUDE_PATH="'$SOURCE_PATH'"'
        echo 'else'
        echo '    export C_INCLUDE_PATH="$C_INCLUDE_PATH:'$SOURCE_PATH'"'
        echo 'fi'
    } >"$PROFILE_D_PATH/$PROFILE_NAME"
    return 0
}

stop() {
    return 0
}

reload() {
    start
}

case "$1" in
start | stop | reload)
    "$1"
    ;;
restart)
    reload
    ;;
*)
    echo "Usage: $0 {start|stop|reload|restart}"
    exit 1
    ;;
esac

exit $?
