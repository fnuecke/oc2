#!/bin/sh

THIS_SCRIPT_PATH=$(readlink -f "$0")
THIS_SCRIPT_DIR=$(dirname "$THIS_SCRIPT_PATH")

LIBRARY_LABEL="MicroPython"
PROFILE_D_PATH="/etc/profile.d"
PROFILE_NAME="python_path.sh"
SOURCE_PATH=$(readlink -f "$THIS_SCRIPT_DIR/../lib/micropython")
STAGE_PATH="/run/oc2/lib/micropython"
STAGE_MIN_FREE_KB=1024

free_kb() {
    df -k "$1" 2>/dev/null | awk 'NR > 1 && NF >= 4 { print $(NF - 2) }' | tail -n 1
}

stage() {
    stage_parent=$(dirname "$STAGE_PATH")

    mkdir -p "$stage_parent" 2>/dev/null || return 1

    free=$(free_kb "$stage_parent")
    case "$free" in
    '' | *[!0-9]*) return 1 ;;
    esac
    [ "$free" -gt "$STAGE_MIN_FREE_KB" ] || return 1

    rm -rf "$STAGE_PATH"
    mkdir -p "$STAGE_PATH" 2>/dev/null || return 1
    if ! cp -r "$SOURCE_PATH/." "$STAGE_PATH/" 2>/dev/null; then
        rm -rf "$STAGE_PATH"
        return 1
    fi
    return 0
}

write_profile() {
    lib_path="$1"
    {
        printf '# Generated by %s on every boot.\n' "$THIS_SCRIPT_PATH"
        printf '# Safe to overwrite -- any edits here are lost the next time the machine starts.\n'
        echo 'if [ -z "$MICROPYPATH" ]; then'
        echo '    export MICROPYPATH="'$lib_path'"'
        echo 'else'
        echo '    export MICROPYPATH="$MICROPYPATH:'$lib_path'"'
        echo 'fi'
    } >"$PROFILE_D_PATH/$PROFILE_NAME"
}

start() {
    if [ ! -d "$SOURCE_PATH" ]; then
        return 0
    fi

    if stage; then
        write_profile "$STAGE_PATH"
    else
        printf 'Staging %s libraries failed, falling back to %s\n' "$LIBRARY_LABEL" "$SOURCE_PATH"
        write_profile "$SOURCE_PATH"
    fi
    return 0
}

stop() {
    rm -rf "$STAGE_PATH"
    return 0
}

reload() {
    stop
    start
}

case "$1" in
start | stop | reload)
    "$1"
    ;;
restart)
    reload
    ;;
*)
    echo "Usage: $0 {start|stop|reload|restart}"
    exit 1
    ;;
esac

exit $?
