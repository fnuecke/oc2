msgctxt "itemGroup.oc2.common"
msgid "OpenComputers II"
msgstr "OpenComputers II"

msgctxt "block.oc2.computer"
msgid "Computer"
msgstr "Computer"

msgctxt "block.oc2.computer.desc"
msgid "Runs software from Flash Memory and Hard Disks."
msgstr "Führt Software von Flash-Speicher und Festplatten aus."

msgctxt "block.oc2.computer.preconfigured"
msgid "Preconfigured Computer"
msgstr "Vorkonfigurierter Computer"

msgctxt "block.oc2.bus_cable"
msgid "Bus Cable"
msgstr "Bus-Kabel"

msgctxt "block.oc2.bus_cable.desc"
msgid "Connects Bus Interfaces."
msgstr "Verbindet Bus-Schnittstellen."

msgctxt "block.oc2.network_connector"
msgid "Network Connector"
msgstr "Netzwerk-Connector"

msgctxt "block.oc2.network_connector.desc"
msgid "Transmits network packets via Network Cables."
msgstr "Überträgt Netzwerkpakete über Netzwerkkabel."

msgctxt "block.oc2.internet_gateway"
msgid "Internet Gateway"
msgstr "Internet-Gateway"

msgctxt "block.oc2.internet_gateway.desc"
msgid "Connects a network to the internet."
msgstr "Stellt eine Netzwerkverbindung zum Internet her."

msgctxt "block.oc2.network_hub"
msgid "Network Hub"
msgstr "Netzwerk-Hub"

msgctxt "block.oc2.network_hub.desc"
msgid "Distributes network packets among all attached Network Connectors."
msgstr "Verteilt Netzwerkpakete auf alle angeschlossenen Netzwerkanschlüsse."

msgctxt "block.oc2.redstone_interface"
msgid "Redstone Interface"
msgstr "Redstone-Schnittstelle"

msgctxt "block.oc2.redstone_interface.desc"
msgid "Emits and reads redstone signals."
msgstr "Sendet und liest Redstone-Signale."

msgctxt "block.oc2.transposer"
msgid "Transposer"
msgstr "Transposer"

msgctxt "block.oc2.transposer.desc"
msgid "Moves items between adjacent inventories."
msgstr "Verschiebt Gegenstände zwischen benachbarten Inventaren."

msgctxt "block.oc2.disk_drive"
msgid "Disk Drive"
msgstr "Laufwerk"

msgctxt "block.oc2.disk_drive.desc"
msgid "Used to access Floppy Disks."
msgstr "Wird für den Zugriff auf Disketten verwendet."

msgctxt "block.oc2.flash_drive"
msgid "Flash Drive"
msgstr "Speicherkartenleser"

msgctxt "block.oc2.flash_drive.desc"
msgid "Used to access Flash Memory."
msgstr "Wird für den Zugriff auf den Flash-Speicher verwendet."

msgctxt "block.oc2.terminal"
msgid "Terminal"
msgstr "Terminal"

msgctxt "block.oc2.terminal.desc"
msgid "User input and output over a serial bus."
msgstr "Benutzereingaben und -ausgaben über einen seriellen Bus."

msgctxt "block.oc2.charger"
msgid "Charger"
msgstr "Ladegerät"

msgctxt "block.oc2.charger.desc"
msgid "Charges entities and items in containers on top of it."
msgstr "Lädt Entities und Gegenstände in Behältern über sich."

msgctxt "block.oc2.creative_energy"
msgid "Infinite Energy Cube"
msgstr "Endloser Energiewürfel"

msgctxt "block.oc2.creative_energy.desc"
msgid "Provides unlimited energy to adjacent blocks. Intended for testing."
msgstr ""
"Versorgt benachbarte Blöcke mit unbegrenzter Energie. Nur zu Testzwecken "
"gedacht."

msgctxt "block.oc2.projector"
msgid "Projector"
msgstr "Projektor"

msgctxt "block.oc2.projector.desc"
msgid "Projects images onto surfaces in front of it."
msgstr "Wirft Bilder auf Oberflächen vor sich."

msgctxt "block.oc2.keyboard"
msgid "Keyboard"
msgstr "Tastatur"

msgctxt "block.oc2.keyboard.desc"
msgid "Allows keyboard input when using a projector."
msgstr "Ermöglicht die Tastatureingabe bei Verwendung eines Projektors."

msgctxt "item.oc2.wrench"
msgid "Scrench"
msgstr "Schraubzieher"

msgctxt "item.oc2.wrench.desc"
msgid "Configures devices and dismantles them (while sneaking)."
msgstr "Konfiguriert Geräte und baut sie ab (im Schleichmodus)."

msgctxt "item.oc2.manual"
msgid "The Computerist's Handbook"
msgstr "Des Computerists Handbuch"

msgctxt "item.oc2.manual.desc"
msgid "Holds information on all things needed when working with Computers."
msgstr ""
"Enthält Informationen zu allem, was man für die Arbeit mit Computern "
"benötigt."

msgctxt "item.oc2.bus_interface"
msgid "Bus Interface"
msgstr "Bus-Schnittstelle"

msgctxt "item.oc2.bus_interface.desc"
msgid "Connects external devices to Computers."
msgstr "Verbindet externe Geräte mit Computern."

msgctxt "item.oc2.network_cable"
msgid "Network Cable"
msgstr "Netzwerkkabel"

msgctxt "item.oc2.network_cable.desc"
msgid "Connects Network Connectors."
msgstr "Verbindet Netzwerkanschlüsse."

msgctxt "item.oc2.memory"
msgid "Memory"
msgstr "Speicher"

msgctxt "item.oc2.memory.desc"
msgid "Random Access Memory (RAM) used in Computers and Robots."
msgstr "Arbeitsspeicher (RAM), der in Computern und Robotern verwendet wird."

msgctxt "item.oc2.hard_drive"
msgid "Hard Drive"
msgstr "Festplatte"

msgctxt "item.oc2.hard_drive.desc"
msgid "Mass storage for operating systems and data."
msgstr "Massenspeicher für Betriebssysteme und Daten."

msgctxt "item.oc2.floppy"
msgid "Floppy Disk"
msgstr "Diskette"

msgctxt "item.oc2.floppy.desc"
msgid "Portable storage used to transfer data between Computers."
msgstr ""
"Tragbare Speichermedien, die zur Datenübertragung zwischen Computern "
"verwendet werden."

msgctxt "item.oc2.flash_memory"
msgid "Flash Memory"
msgstr "Flash-Speicher"

msgctxt "item.oc2.flash_memory.desc"
msgid "Readonly storage for firmware."
msgstr "Schreibgeschützter Speicher für Firmware."

msgctxt "item.oc2.cpu_z80"
msgid "Z80 Processor"
msgstr "Z80-Prozessor"

msgctxt "item.oc2.cpu_z80.desc"
msgid "An 8-bit processor. Runs CP/M."
msgstr "Ein 8-Bit-Prozessor. Läuft unter CP/M."

msgctxt "item.oc2.cpu_riscv"
msgid "RISC-V Processor"
msgstr "RISC-V-Prozessor"

msgctxt "item.oc2.cpu_riscv.desc"
msgid "A 64-bit processor. Runs OpenOS II and Linux."
msgstr "Ein 64-Bit-Prozessor. Läuft unter OpenOS II und Linux."

msgctxt "item.oc2.redstone_interface_card"
msgid "Redstone Interface Card"
msgstr "Redstone-Schnittstellenkarte"

msgctxt "item.oc2.redstone_interface_card.desc"
msgid "Emits and reads redstone signals through the Computer."
msgstr "Sendet und empfängt Redstone-Signale über den Computer."

msgctxt "item.oc2.network_interface_card"
msgid "Network Interface Card"
msgstr "Netzwerkkarte"

msgctxt "item.oc2.network_interface_card.desc"
msgid "Sends and receives network packets via attached Network Connectors."
msgstr ""
"Sendet und empfängt Netzwerkpakete über angeschlossene Netzwerkanschlüsse."

msgctxt "item.oc2.sided_device.is_configured"
msgid "Has connectivity configuration."
msgstr "Seiten konfigurierbar."

msgctxt "item.oc2.serial_interface_card"
msgid "Serial Interface Card"
msgstr "Serielles Schnittstellenmodul"

msgctxt "item.oc2.serial_interface_card.desc"
msgid "Sends and receives serial communication via attached Network Connectors."
msgstr ""
"Sendet und empfängt serielle Daten über angeschlossene Netzwerkanschlüsse."

msgctxt "item.oc2.serial_interface_card.configuration"
msgid "Address: %s"
msgstr "Adresse: %s"

msgctxt "item.oc2.network_tunnel_card"
msgid "Network Tunnel Card"
msgstr "Netzwerktunnel-Karte"

msgctxt "item.oc2.network_tunnel_card.desc"
msgid "Sends and receives network packets to a linked device."
msgstr "Sendet und empfängt Netzwerkpakete an ein verbundenes Gerät."

msgctxt "item.oc2.file_import_export_card"
msgid "File Import/Export Card"
msgstr "Datei-Import/Export-Karte"

msgctxt "item.oc2.file_import_export_card.desc"
msgid "Imports and exports files from and into your real file system."
msgstr ""
"Importiert und exportiert Dateien aus dem realen Dateisystem und in dieses "
"hinein."

msgctxt "item.oc2.robot"
msgid "Robot"
msgstr "Roboter"

msgctxt "item.oc2.robot.desc"
msgid "A mobile Computer. Use a Scrench to pick it back up."
msgstr ""
"Ein mobiler Computer. Benutze einen Schraubzieher, um ihn wieder aufzuheben."

msgctxt "item.oc2.robot.preconfigured"
msgid "Preconfigured Robot"
msgstr "Vorkonfigurierter Roboter"

msgctxt "item.oc2.crafting_module"
msgid "Crafting Module"
msgstr "Crafting-Modul"

msgctxt "item.oc2.crafting_module.desc"
msgid "Crafts items in the Robot's inventory."
msgstr "Craftet Gegenstände im Inventar des Roboters."

msgctxt "item.oc2.inventory_operations_module"
msgid "Inventory Operations Module"
msgstr "Modul für Inventaroperationen"

msgctxt "item.oc2.inventory_operations_module.desc"
msgid "Moves items in, into and out of the Robot's inventory."
msgstr "Verschiebt Gegenstände im, in das und aus dem Inventar des Roboters."

msgctxt "item.oc2.tank_operations_module"
msgid "Tank Operations Module"
msgstr "Tank-Interaktions-Modul"

msgctxt "item.oc2.tank_operations_module.desc"
msgid "Moves fluids into and out of the Robot's tank."
msgstr "Führt Flüssigkeiten in den Tank des Roboters hinein und aus ihm heraus."

msgctxt "item.oc2.block_operations_module"
msgid "Block Operations Module"
msgstr "Block-Interaktions-Modul"

msgctxt "item.oc2.block_operations_module.desc"
msgid "Breaks and places blocks."
msgstr "Gräbt und platziert Blöcke."

msgctxt "item.oc2.scanner_module"
msgid "Scanner Module"
msgstr "Scanner-Modul"

msgctxt "item.oc2.scanner_module.desc"
msgid "Identifies adjacent blocks and measures the hardness of nearby ones."
msgstr "Erkennt benachbarte Blöcke und misst die Härte derer in der Nähe."

msgctxt "item.oc2.sound_card"
msgid "Sound Card"
msgstr "Soundkarte"

msgctxt "item.oc2.sound_card.desc"
msgid "Lets a computer do the beeps and boops."
msgstr "Lässt einen Computer Töne haben."

msgctxt "item.oc2.network_tunnel_module"
msgid "Network Tunnel Module"
msgstr "Netzwerktunnel-Modul"

msgctxt "item.oc2.network_tunnel_module.desc"
msgid "Sends and receives network packets to a linked device."
msgstr "Sendet und empfängt Netzwerkpakete an ein verbundenes Gerät."

