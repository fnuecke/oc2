msgctxt "itemGroup.oc2.common"
msgid "OpenComputers II"
msgstr "开放式电脑 II"

msgctxt "block.oc2.computer"
msgid "Computer"
msgstr "电脑"

msgctxt "block.oc2.computer.desc"
msgid "Runs software from Flash Memory and Hard Disks."
msgstr "运行来自闪存和硬盘的软件。"

msgctxt "block.oc2.computer.preconfigured"
msgid "Preconfigured Computer"
msgstr "电脑（已经配置好的）"

msgctxt "block.oc2.bus_cable"
msgid "Bus Cable"
msgstr "总线线缆"

msgctxt "block.oc2.bus_cable.desc"
msgid "Connects Bus Interfaces."
msgstr "与总线接口结合使用，以将外部设备连接到电脑。"

msgctxt "block.oc2.network_connector"
msgid "Network Connector"
msgstr "网络连接器"

msgctxt "block.oc2.network_connector.desc"
msgid "Transmits network packets via Network Cables."
msgstr "通过网线传输网络数据包。"

msgctxt "block.oc2.internet_gateway"
msgid "Internet Gateway"
msgstr "互联网网关"

msgctxt "block.oc2.internet_gateway.desc"
msgid "Connects a network to the internet."
msgstr "将网络连接到现实中的互联网。"

msgctxt "block.oc2.network_hub"
msgid "Network Hub"
msgstr "网线集线器"

msgctxt "block.oc2.network_hub.desc"
msgid "Distributes network packets among all attached Network Connectors."
msgstr "在所有连接的网络连接口之间分配网络数据包。"

msgctxt "block.oc2.redstone_interface"
msgid "Redstone Interface"
msgstr "红石接口"

msgctxt "block.oc2.redstone_interface.desc"
msgid "Emits and reads redstone signals."
msgstr "发出并读取红石信号。"

msgctxt "block.oc2.transposer"
msgid "Transposer"
msgstr "转运器"

msgctxt "block.oc2.transposer.desc"
msgid "Moves items between adjacent inventories."
msgstr "在相邻的容器之间移动物品。"

msgctxt "block.oc2.disk_drive"
msgid "Disk Drive"
msgstr "磁盘驱动器"

msgctxt "block.oc2.disk_drive.desc"
msgid "Used to access Floppy Disks."
msgstr "使用这个来访问软盘。"

msgctxt "block.oc2.flash_drive"
msgid "Flash Drive"
msgstr "闪存驱动器"

msgctxt "block.oc2.flash_drive.desc"
msgid "Used to access Flash Memory."
msgstr "用于访问闪存。"

msgctxt "block.oc2.terminal"
msgid "Terminal"
msgstr "终端"

#, fuzzy
msgctxt "block.oc2.terminal.desc"
msgid "User input and output over a serial bus."
msgstr "通过串行总线进行用户输入和输出。"

msgctxt "block.oc2.charger"
msgid "Charger"
msgstr "充电器"

msgctxt "block.oc2.charger.desc"
msgid "Charges entities and items in containers on top of it."
msgstr "通过站在上面给实体和物品充电。"

msgctxt "block.oc2.creative_energy"
msgid "Infinite Energy Cube"
msgstr "无限能量方块"

msgctxt "block.oc2.creative_energy.desc"
msgid "Provides unlimited energy to adjacent blocks. Intended for testing."
msgstr "提供无限的能量给连接的方块。"

msgctxt "block.oc2.projector"
msgid "Projector"
msgstr "投影仪"

msgctxt "block.oc2.projector.desc"
msgid "Projects images onto surfaces in front of it."
msgstr "将图像投影到它前面的表面上。"

msgctxt "block.oc2.keyboard"
msgid "Keyboard"
msgstr "键盘"

msgctxt "block.oc2.keyboard.desc"
msgid "Allows keyboard input when using a projector."
msgstr "允许在使用投影仪时输入按键。"

msgctxt "item.oc2.wrench"
msgid "Scrench"
msgstr "螺丝刀扳手"

msgctxt "item.oc2.wrench.desc"
msgid "Configures devices and dismantles them (while sneaking)."
msgstr "当潜行时用于配置设备和拆卸设备。"

msgctxt "item.oc2.manual"
msgid "The Computerist's Handbook"
msgstr "计算机科学手册"

msgctxt "item.oc2.manual.desc"
msgid "Holds information on all things needed when working with Computers."
msgstr "保存有关使用计算机时所需的所有信息。"

msgctxt "item.oc2.bus_interface"
msgid "Bus Interface"
msgstr "总线接口"

msgctxt "item.oc2.bus_interface.desc"
msgid "Connects external devices to Computers."
msgstr "通过总线线缆来和外部设备通讯。"

msgctxt "item.oc2.network_cable"
msgid "Network Cable"
msgstr "网线"

msgctxt "item.oc2.network_cable.desc"
msgid "Connects Network Connectors."
msgstr "连接网络接口。"

msgctxt "item.oc2.memory"
msgid "Memory"
msgstr "内存条"

msgctxt "item.oc2.memory.desc"
msgid "Random Access Memory (RAM) used in Computers and Robots."
msgstr "计算机和机器人中使用的内存（RAM）。"

msgctxt "item.oc2.hard_drive"
msgid "Hard Drive"
msgstr "硬盘"

msgctxt "item.oc2.hard_drive.desc"
msgid "Mass storage for operating systems and data."
msgstr "用于操作系统和数据的大容量存储。"

msgctxt "item.oc2.floppy"
msgid "Floppy Disk"
msgstr "软盘"

msgctxt "item.oc2.floppy.desc"
msgid "Portable storage used to transfer data between Computers."
msgstr "用于在计算机之间传输数据的便携式存储。"

msgctxt "item.oc2.flash_memory"
msgid "Flash Memory"
msgstr "闪存"

msgctxt "item.oc2.flash_memory.desc"
msgid "Readonly storage for firmware."
msgstr "固件的只读存储。"

msgctxt "item.oc2.cpu_z80"
msgid "Z80 Processor"
msgstr "Z80 处理器"

msgctxt "item.oc2.cpu_z80.desc"
msgid "An 8-bit processor. Runs CP/M."
msgstr "一款 8 位处理器。运行 CP/M 系统。"

msgctxt "item.oc2.cpu_riscv"
msgid "RISC-V Processor"
msgstr "RISC-V 处理器"

msgctxt "item.oc2.cpu_riscv.desc"
msgid "A 64-bit processor. Runs OpenOS II and Linux."
msgstr "64 位处理器。可运行 OpenOS II 和 Linux。"

msgctxt "item.oc2.redstone_interface_card"
msgid "Redstone Interface Card"
msgstr "红石卡"

msgctxt "item.oc2.redstone_interface_card.desc"
msgid "Emits and reads redstone signals through the Computer."
msgstr "通过计算机发出和读取红石信号。"

msgctxt "item.oc2.network_interface_card"
msgid "Network Interface Card"
msgstr "网卡"

msgctxt "item.oc2.network_interface_card.desc"
msgid "Sends and receives network packets via attached Network Connectors."
msgstr "通过附加的网络接口发送和接收网络数据包。"

msgctxt "item.oc2.sided_device.is_configured"
msgid "Has connectivity configuration."
msgstr "已配置。"

msgctxt "item.oc2.serial_interface_card"
msgid "Serial Interface Card"
msgstr "串口卡"

msgctxt "item.oc2.serial_interface_card.desc"
msgid ""
"Sends and receives serial communication via attached Network Connectors."
msgstr "通过网络连接器发送和接收串行通信。"

#, fuzzy
msgctxt "item.oc2.serial_interface_card.configuration"
msgid "Address: %s"
msgstr "连接地址：%s"

msgctxt "item.oc2.network_tunnel_card"
msgid "Network Tunnel Card"
msgstr "网络隧道卡"

msgctxt "item.oc2.network_tunnel_card.desc"
msgid "Sends and receives network packets to a linked device."
msgstr "向链接设备发送和接收网络数据包。"

msgctxt "item.oc2.file_import_export_card"
msgid "File Import/Export Card"
msgstr "文件导入/导出卡"

msgctxt "item.oc2.file_import_export_card.desc"
msgid "Imports and exports files from and into your real file system."
msgstr "可以从真实的文件系统导入/导出文件。"

msgctxt "item.oc2.robot"
msgid "Robot"
msgstr "机器人"

msgctxt "item.oc2.robot.desc"
msgid "A mobile Computer. Use a Scrench to pick it back up."
msgstr "使用螺丝刀扳手或者兼容的扳手来添加或移除组件。"

